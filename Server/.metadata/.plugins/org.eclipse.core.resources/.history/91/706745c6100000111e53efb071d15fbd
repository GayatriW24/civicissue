package com.civicissues.controller;

import java.util.List;
import java.util.Map;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.civicissues.dto.ComplaintCreateDto;
import com.civicissues.dto.ComplaintResponseDto;
import com.civicissues.entity.ComplaintStatus;
import com.civicissues.service.ComplaintService;

import jakarta.validation.Valid;

@RestController
@RequestMapping("/api/complaints")
public class ComplaintController {

    private final ComplaintService complaintService;

    public ComplaintController(ComplaintService complaintService) {
        this.complaintService = complaintService;
    }

    /* ================= CREATE ================= */

    @PostMapping
    public ResponseEntity<ComplaintResponseDto> create(
            @RequestHeader("X-CITIZEN-AADHAAR") String aadhaar,
            @Valid @RequestBody ComplaintCreateDto dto
    ) {
        if (aadhaar == null || aadhaar.isBlank()) {
            return ResponseEntity.status(HttpStatus.UNAUTHORIZED)
                    .body(null);
        }

        ComplaintResponseDto response = complaintService.createComplaint(aadhaar, dto);
        return ResponseEntity.status(HttpStatus.CREATED).body(response);
    }

    /* ================= READ ================= */

    @GetMapping("/{id}")
    public ResponseEntity<ComplaintResponseDto> getById(@PathVariable Long id) {
        return ResponseEntity.ok(complaintService.getComplaintById(id));
    }

    @GetMapping
    public ResponseEntity<List<ComplaintResponseDto>> getAll(
            @RequestHeader("departmentId") Long departmentId,
            @RequestHeader("role") String role
    ) {
        if ("ADMIN".equals(role) && departmentId != null) {
            return ResponseEntity.ok(complaintService.getByDepartment(departmentId));
        }
        return ResponseEntity.ok(complaintService.getAllComplaints());
    }

    @GetMapping("/{id}/exists")
    public ResponseEntity<Boolean> exists(@PathVariable Long id) {
        return ResponseEntity.ok(complaintService.existsById(id));
    }

    @GetMapping("/department/{departmentId}")
    public ResponseEntity<List<ComplaintResponseDto>> byDepartment(
            @PathVariable Long departmentId
    ) {
        return ResponseEntity.ok(complaintService.getByDepartment(departmentId));
    }

    @GetMapping("/department")
    public ResponseEntity<List<ComplaintResponseDto>> getByDepartment(
            @RequestParam Long departmentId
    ) {
        return ResponseEntity.ok(complaintService.getByDepartment(departmentId));
    }

    @GetMapping("/my")
    public ResponseEntity<List<ComplaintResponseDto>> getMyComplaints(
            @RequestHeader("X-CITIZEN-AADHAAR") String citizenAadhaar
    ) {
        return ResponseEntity.ok(
                complaintService.getByCitizen(citizenAadhaar)
        );
    }

    /* ================= UPDATE ================= */

    @PutMapping("/{id}/status/{status}")
    public ResponseEntity<ComplaintResponseDto> updateStatus(
            @PathVariable Long id,
            @PathVariable ComplaintStatus status,
            @RequestHeader("role") String role,
            @RequestHeader(value = "departmentId", required = false) Long departmentId
    ) {
        ComplaintResponseDto complaint = complaintService.getComplaintById(id);

        if ("ADMIN".equals(role)) {
            if (departmentId == null || !complaint.getDepartmentId().equals(departmentId)) {
                return ResponseEntity.status(HttpStatus.FORBIDDEN).build();
            }
        }

        return ResponseEntity.ok(
                complaintService.updateStatus(id, status)
        );
    }

    /* ================= ANALYTICS ================= */

    @GetMapping("/analytics/status")
    public ResponseEntity<Map<ComplaintStatus, Long>> statusAnalytics() {
        return ResponseEntity.ok(complaintService.countByStatus());
    }

    @GetMapping("/analytics/city")
    public ResponseEntity<List<Object[]>> complaintsByCity() {
        return ResponseEntity.ok(complaintService.countByCity());
    }

    @GetMapping("/analytics/category")
    public ResponseEntity<List<Object[]>> complaintsByCategory() {
        return ResponseEntity.ok(complaintService.countByCategory());
    }
}

