package com.civicissues.async;

@Component
@Slf4j
@RequiredArgsConstructor
public class AppointmentEventListener {
	private final EmailService emailService;

	@RabbitListener(queues = "notification.queue")
	public void handle(AppointmentEvent event) {

		log.info("Received event: {}", event);

		if (event.getType().equals("BOOKED")) {
			log.info("Appointment Booked ");
			emailService.sendBookedEmail(event);
		}

		if (event.getType().equals("CANCELLED")) {
			log.info("Appointment Cancelled ");
			emailService.sendCancelledEmail(event);
		}
	}
}

