server.port=8084
spring.application.name=api-gateway

jwt.secret=mysupersecretkeymysupersecretkey12345

spring.cloud.gateway.globalcors.corsConfigurations.[/**].allowedOrigins=http://localhost:5173
spring.cloud.gateway.globalcors.corsConfigurations.[/**].allowedMethods=*
spring.cloud.gateway.globalcors.corsConfigurations.[/**].allowedHeaders=*
spring.cloud.gateway.globalcors.corsConfigurations.[/**].allowCredentials=false
spring.cloud.gateway.globalcors.add-to-simple-url-handler-mapping=true


spring.cloud.gateway.default-filters[0]=PreserveHostHeader

spring.cloud.gateway.routes[0].id=user-service
spring.cloud.gateway.routes[0].uri=http://localhost:8083
spring.cloud.gateway.routes[0].predicates[0]=Path=/auth/**,/users/**,/admin/**

spring.cloud.gateway.routes[1].id=complaint-service
spring.cloud.gateway.routes[1].uri=http://localhost:8081
spring.cloud.gateway.routes[1].predicates[0]=Path=/api/complaints/**,/api/attachments/**./files/**

spring.cloud.gateway.routes[2].id=masterdata-service
spring.cloud.gateway.routes[2].uri=http://localhost:8082
spring.cloud.gateway.routes[2].predicates[0]=Path=/api/departments/**,/api/categories/**

spring.cloud.gateway.routes[3].id=interaction-service
spring.cloud.gateway.routes[3].uri=http://localhost:8089
spring.cloud.gateway.routes[3].predicates[0]=Path=/api/responses/**,/api/feedbacks/**


