import org.springframework.cloud.gateway.filter.GlobalFilter;
import org.springframework.context.annotation.Bean;
import org.springframework.http.HttpStatus;

@Bean
public GlobalFilter userIdForwardingFilter() {
    return (exchange, chain) -> {

        String path = exchange.getRequest().getURI().getPath();

        // Allow auth & user management without JWT
        if (path.startsWith("/auth") || path.startsWith("/users") || path.startsWith("/admin")) {
            return chain.filter(exchange);
        }

        String authHeader = exchange.getRequest()
                .getHeaders()
                .getFirst("Authorization");

        if (authHeader == null || !authHeader.startsWith("Bearer ")) {
            exchange.getResponse().setStatusCode(HttpStatus.UNAUTHORIZED);
            return exchange.getResponse().setComplete();
        }

        String token = authHeader.substring(7);

        try {
            String aadhaar = jwtUtil.extractAadhaar(token);
            String role = jwtUtil.extractRole(token);
            Long departmentId = jwtUtil.extractDepartmentId(token);

            return chain.filter(
                exchange.mutate()
                    .request(r -> {
                        r.header("X-CITIZEN-AADHAAR", aadhaar);
                        if (role != null) {
                            r.header("role", role);
                        }
                        if (departmentId != null) {
                            r.header("departmentId", String.valueOf(departmentId));
                        }
                    })
                    .build()
            );

        } catch (Exception e) {
            e.printStackTrace(); // 🔴 IMPORTANT while debugging
            exchange.getResponse().setStatusCode(HttpStatus.UNAUTHORIZED);
            return exchange.getResponse().setComplete();
        }
    };
}
