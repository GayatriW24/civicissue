spring.application.name=complaint-service
server.port=8081

spring.datasource.url=jdbc:mysql://localhost:3308/complaintdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
#spring.datasource.url=jdbc:mysql://mysql:3308/complaintdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

spring.datasource.username=root
spring.datasource.password=root123
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false
spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update
logging.level.org.springframework.security=debug


spring.rabbitmq.host=localhost
spring.rabbitmq.port=5672
spring.rabbitmq.username=guest
spring.rabbitmq.password=guest


management.endpoints.web.exposure.include=*
management.endpoint.health.show-details=always
#specifically enable monitoring of circuitbreakers end points
management.health.circuitbreakers.enabled=true

resilience4j.circuitbreaker.instances.ums.register-health-indicator=true
resilience4j.circuitbreaker.instances.ums.sliding-window-type=COUNT_BASED
resilience4j.circuitbreaker.instances.ums.sliding-window-size=10
resilience4j.circuitbreaker.instances.ums.minimum-number-of-calls=3
resilience4j.circuitbreaker.instances.ums.failure-rate-threshold=50
resilience4j.circuitbreaker.instances.ums.wait-duration-in-open-state=10s
resilience4j.circuitbreaker.instances.ums.permitted-number-of-calls-in-half-open-state=3
resilience4j.circuitbreaker.instances.ums.automatic-transition-from-open-to-half-open-enabled=true
resilience4j.timelimiter.instances.ums.timeout-duration=2s

feign.client.config.default.connectTimeout=2000
feign.client.config.default.readTimeout=2000

# Eureka - disable for local
eureka.client.register-with-eureka=false
eureka.client.fetch-registry=false
# or enable in production
# eureka.client.service-url.defaultZone=http://localhost:8761/eureka
eureka.client.enabled=false

