package com.civicissues.controller;


import java.util.List;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestHeader;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.civicissues.dto.ApiResponse;
import com.civicissues.dto.ComplaintCreateDto;
import com.civicissues.dto.ComplaintResponseDto;
import com.civicissues.dto.StatusUpdateDto;
import com.civicissues.exception.UnauthorizedException;
import com.civicissues.service.ComplaintService;

import jakarta.validation.Valid;

@RestController
@RequestMapping("/api/complaints")
public class ComplaintController {

    private final ComplaintService complaintService;

    public ComplaintController(ComplaintService complaintService) {
        this.complaintService = complaintService;
    }

    @PostMapping
    public ResponseEntity<ApiResponse<ComplaintResponseDto>> create(
            @RequestHeader("X-CITIZEN-AADHAAR") String aadhaar,
            @Valid @RequestBody ComplaintCreateDto dto
    ) {
        if (aadhaar == null || aadhaar.isBlank()) {
            throw new UnauthorizedException("Missing Aadhaar header");
        }

        ComplaintResponseDto response =
                complaintService.createComplaint(aadhaar, dto);

        return ResponseEntity.status(HttpStatus.CREATED)
                .body(new ApiResponse<>(true, "Complaint created", response));
    }

    @GetMapping("/{id}")
    public ResponseEntity<ApiResponse<ComplaintResponseDto>> getById(@PathVariable Long id) {
        return ResponseEntity.ok(
                new ApiResponse<>(true, "Complaint fetched",
                        complaintService.getComplaintById(id))
        );
    }

    @GetMapping
    public ResponseEntity<ApiResponse<List<ComplaintResponseDto>>> getAll(
            @RequestHeader("departmentId") Long departmentId,
            @RequestHeader("role") String role
    ) {
        List<ComplaintResponseDto> data =
                "ADMIN".equals(role) && departmentId != null
                        ? complaintService.getByDepartment(departmentId)
                        : complaintService.getAllComplaints();

        return ResponseEntity.ok(new ApiResponse<>(true, "Complaints fetched", data));
    }

