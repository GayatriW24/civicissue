    @PutMapping("/{id}/status")
    public ResponseEntity<ApiResponse<ComplaintResponseDto>> updateStatus(
            @PathVariable Long id,
            @Valid @RequestBody StatusUpdateDto dto,
            @RequestHeader("role") String role,
            @RequestHeader(value = "departmentId", required = false) Long departmentId
    ) {
        ComplaintResponseDto updatedComplaint =
                complaintService.updateStatus(id, dto.getStatus(), role, departmentId);

        return ResponseEntity.ok(
                new ApiResponse<>(true, "Status updated", updatedComplaint)
        );
    }



    @GetMapping("/my")
    public ResponseEntity<ApiResponse<List<ComplaintResponseDto>>> myComplaints(
            @RequestHeader("X-CITIZEN-AADHAAR") String aadhaar
    ) {
        return ResponseEntity.ok(
                new ApiResponse<>(true, "My complaints",
                        complaintService.getByCitizen(aadhaar))
        );
    }
}
