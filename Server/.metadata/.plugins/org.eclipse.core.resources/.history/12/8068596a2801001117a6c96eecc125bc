package com.civicissues.controller;

import java.util.List;
import java.util.stream.Collectors;

import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.web.bind.annotation.*;

import com.civicissues.dto.CreateAdminRequest;
import com.civicissues.dto.AdminResponseDto;
import com.civicissues.dto.response.ApiResponse;
import com.civicissues.entity.Role;
import com.civicissues.entity.User;
import com.civicissues.exception.ResourceNotFoundException;
import com.civicissues.repository.UserRepository;

import jakarta.validation.Valid;

@RestController
@RequestMapping("/admin")
public class AdminController {

    private final UserRepository userRepository;
    private final PasswordEncoder encoder;

    public AdminController(UserRepository userRepository, PasswordEncoder encoder) {
        this.userRepository = userRepository;
        this.encoder = encoder;
    }

    @PreAuthorize("hasRole('SUPER_ADMIN')")
    @PostMapping("/create-admin")
    public ResponseEntity<ApiResponse<Void>> createAdmin(
            @Valid @RequestBody CreateAdminRequest request) {

        User user = new User();
        user.setName(request.getName());
        user.setAadhaar(request.getAadhaar());
        user.setPhone(request.getPhone());
        user.setEmail(request.getEmail());
        user.setDepartmentId(request.getDepartmentId());

        user.setPassword(encoder.encode("admin123"));
        user.setRole(Role.ADMIN);
        user.setActive(true);

        userRepository.save(user);

        return ResponseEntity.status(HttpStatus.CREATED)
                .body(new ApiResponse<>(true, "Admin created successfully", null));
    }

    @PreAuthorize("hasRole('SUPER_ADMIN')")
    @PutMapping("/deactivate/{userId}")
    public ResponseEntity<ApiResponse<Void>> deactivate(@PathVariable Long userId) {

        User user = userRepository.findById(userId)
                .orElseThrow(() -> new ResourceNotFoundException("User not found"));

        user.setActive(false);
        userRepository.save(user);

        return ResponseEntity.ok(
                new ApiResponse<>(true, "User deactivated successfully", null));
    }

    
    //@PreAuthorize("hasRole('SUPER_ADMIN')")
    @GetMapping("/list")
    public ResponseEntity<ApiResponse<List<AdminResponseDto>>> listAdmins() {
        List<AdminResponseDto> admins = userRepository.findAll().stream()
                .filter(u -> u.getRole() == Role.ADMIN)
                .map(u -> new AdminResponseDto(
                        u.getId(),
                        u.getName(),
                        u.getAadhaar(),
                        u.getPhone(),
                        u.getEmail(),
                        u.getDepartmentId(),
                        u.isActive()
                ))
                .collect(Collectors.toList());

        return ResponseEntity.ok(new ApiResponse<>(true, "Admins fetched successfully", admins));
    }
}
