    @Override
    public ComplaintResponseDto createComplaint(
    		String citizenAadhaar,
            ComplaintCreateDto dto
    ) {

        boolean alreadyExists =
            complaintRepository.existsByCitizenAadhaarAndCategoryIdAndAreaAndStatus
            (
            	citizenAadhaar,
                dto.getCategoryId(),
                dto.getArea(),
                ComplaintStatus.OPEN
            );

        if (alreadyExists) {
            throw new IllegalStateException(
                "complaint already exists for this issue in your area"
            );
        }

        Complaint complaint = new Complaint();
      //  complaint.setCitizenId(citizenAadhaar);
        complaint.setCitizenAadhaar(citizenAadhaar);

        complaint.setDepartmentId(dto.getDepartmentId());
        complaint.setCategoryId(dto.getCategoryId());
        complaint.setDescription(dto.getDescription());
        complaint.setArea(dto.getArea());
        complaint.setCity(dto.getCity());
        complaint.setStatus(ComplaintStatus.OPEN);
        complaint.setCreatedAt(LocalDateTime.now());

        Complaint saved = complaintRepository.save(complaint);

        NotificationEvent event = new NotificationEvent();
        
        event.setComplaintId(saved.getId());
        event.setType("COMPLAINT_CREATED");
        event.setCitizenAadhaar(citizenAadhaar);

        //event.setUserId(citizenAadhaar);
        event.setMessage("your complaint has been registered");
        event.setCreatedAt(LocalDateTime.now());

        publisher.publish(event);

        ComplaintResponseDto res = new ComplaintResponseDto();
        res.setId(saved.getId());
       // res.setCitizenId(saved.getCitizenId());
        res.setCitizenAadhaar(saved.getCitizenAadhaar());

        res.setDepartmentId(saved.getDepartmentId());
        res.setCategoryId(saved.getCategoryId());
        res.setArea(saved.getArea());
        res.setCity(saved.getCity());
        res.setDescription(saved.getDescription());
        res.setStatus(saved.getStatus());
        res.setCreatedAt(saved.getCreatedAt());

        return res;
    }

   

	@Override
    public ComplaintResponseDto updateStatus(Long complaintId, ComplaintStatus status) {

        Complaint complaint = complaintRepository.findById(complaintId)
                .orElseThrow(() -> new ResourceNotFoundException("complaint not found"));

        complaint.setStatus(status);
        Complaint updated = complaintRepository.save(complaint);

        NotificationEvent event = new NotificationEvent();
        event.setComplaintId(updated.getId());
        event.setType("COMPLAINT_RESOLVED");
        event.setCitizenAadhaar(updated.getCitizenAadhaar());

       // event.setUserId(updated.getCitizenId());
        event.setMessage("your complaint has been resolved");
        event.setCreatedAt(LocalDateTime.now());

        publisher.publish(event);


        ComplaintResponseDto dto = new ComplaintResponseDto();
        dto.setId(updated.getId());
        dto.setCitizenAadhaar(updated.getCitizenAadhaar());

        //dto.setCitizenId(updated.getCitizenId());
        dto.setDepartmentId(updated.getDepartmentId());
        dto.setCategoryId(updated.getCategoryId());
        dto.setArea(updated.getArea());
        dto.setCity(updated.getCity());
        dto.setDescription(updated.getDescription());
        dto.setStatus(updated.getStatus());
        dto.setCreatedAt(updated.getCreatedAt());

        return dto;
    }

